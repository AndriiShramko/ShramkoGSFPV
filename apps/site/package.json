{
  "name": "@gsfpv/site",
  "version": "0.1.0",
  "private": true,
  "description": "Public landing of ShramkoGSFPV (Next.js static export, 4 languages)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "gen": "node scripts/numbers.mjs && node scripts/media.mjs",
    "predev": "node scripts/numbers.mjs && node scripts/media.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/numbers.mjs && node scripts/media.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-lang.mjs",
    "og": "node scripts/og.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "serve": "node scripts/serve.mjs 8138",
    "verify": "node scripts/verify.mjs",
    "a11y": "node scripts/a11y.mjs",
    "typecheck": "node scripts/numbers.mjs && node scripts/media.mjs && next typegen && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gsfpv/i18n": "workspace:*",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
