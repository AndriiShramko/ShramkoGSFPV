{
  "v": 1,
  "about": "The admin ideas API as the kanban (apps/fly/src/admin/ideas/) relies on it: one list of calls with the answers they must get. apps/api/tests/test_ideas_contract.py replays it against the real handler (server.py -> admin.py -> ideas_admin.py -> service.py); tools/bench/test/ideas-contract.test.ts replays it against tools/bench/src/ideas-mock.ts, which the kanban's tests and browser harness use. A change on either side fails one of the two until this file, the server and the mock agree again. Steps: get/post a route under /api/admin/ with a body; status, reason, the answer's sorted keys (keys), values at dotted paths (expect; * maps over a list); save stores a value for later $name; world changes the server's surroundings (mail: Gmail set up or not; store: broken = ideas.json unreadable).",
  "ideas": {
    "pilot": { "id": "R-20261013-0101", "kind": "idea", "text": "Rates types: Betaflight, Raceflight, KISS, Actual, Quick.", "contact": "pilot.contract@example.com", "lang": "pl" },
    "other": { "id": "R-20261013-0102", "kind": "bug", "text": "The throttle stops after a window switch.", "contact": "", "lang": "en" }
  },
  "steps": [
    { "say": "the list carries the setup", "get": "ideas", "status": 200, "keys": ["bot", "ideas", "mail", "ok", "undoSeconds"], "expect": { "mail.configured": true, "undoSeconds": 60, "ideas.*.id": ["$pilot", "$other"] } },
    { "say": "one idea", "get": "ideas/$pilot", "status": 200, "keys": ["idea", "ok"], "expect": { "idea.id": "$pilot", "idea.status": "new", "idea.email": "pilot.contract@example.com", "idea.contactKind": "email", "idea.thread": [] } },
    { "say": "an unknown idea", "get": "ideas/R-20990101-0001", "status": 404, "keys": ["ok"] },
    { "say": "a move with an urgency", "post": "ideas/update", "body": { "id": "$pilot", "status": "accepted", "urgency": "high" }, "status": 200, "keys": ["idea", "ok"], "expect": { "idea.status": "accepted", "idea.urgency": "high" } },
    { "say": "null clears the urgency", "post": "ideas/update", "body": { "id": "$pilot", "urgency": null }, "status": 200, "expect": { "idea.urgency": null, "idea.status": "accepted" } },
    { "say": "a status the store does not know", "post": "ideas/update", "body": { "id": "$pilot", "status": "someday" }, "status": 400, "keys": ["ok", "reason"], "expect": { "reason": "bad-status" } },
    { "say": "a field the route does not know", "post": "ideas/update", "body": { "id": "$pilot", "evil": 1 }, "status": 400, "expect": { "reason": "unknown-field" } },
    { "say": "a comment", "post": "ideas/update", "body": { "id": "$pilot", "comment": "With the HUD work" }, "status": 200, "expect": { "idea.comments.*.text": ["With the HUD work"] } },
    { "say": "the public title and the landing switch", "post": "ideas/update", "body": { "id": "$pilot", "publicTitle": { "en": "Rates types", "pl": "Typy rates" }, "visible": false }, "status": 200, "expect": { "idea.public.title.en": "Rates types", "idea.public.title.pl": "Typy rates", "idea.public.visible": false } },
    { "say": "an unknown idea is not moved", "post": "ideas/update", "body": { "id": "R-20990101-0001", "status": "accepted" }, "status": 404, "expect": { "reason": "not-found" } },
    { "say": "a reply is queued behind the undo window", "post": "ideas/reply", "body": { "id": "$pilot", "text": "Thanks, queued for the next build." }, "status": 200, "keys": ["idea", "mail", "ok"], "expect": { "mail.kind": "reply", "mail.state": "queued", "mail.to": "pilot.contract@example.com", "idea.thread.*.state": ["queued"] }, "save": { "r1": "mail.id" } },
    { "say": "Cancel in the undo window", "post": "ideas/mail/cancel", "body": { "id": "$r1" }, "status": 200, "keys": ["idea", "mail", "ok"], "expect": { "mail.id": "$r1", "mail.state": "cancelled" } },
    { "say": "a cancelled e-mail is not sent again", "post": "ideas/mail/send", "body": { "id": "$r1" }, "status": 409, "expect": { "reason": "not-resendable" } },
    { "say": "a reply to a pilot without an e-mail", "post": "ideas/reply", "body": { "id": "$other", "text": "Fixed, thanks." }, "status": 200, "expect": { "mail.state": "no_email", "mail.to": "" } },
    { "say": "done without an e-mail: no draft", "post": "ideas/done", "body": { "id": "$other", "summary": { "en": "Fixed in the latest release." } }, "status": 200, "keys": ["draft", "idea", "ok"], "expect": { "draft": null, "idea.status": "done" } },
    { "say": "done with an e-mail: a draft thank-you, nothing queued", "post": "ideas/done", "body": { "id": "$pilot", "summary": { "pl": "Typy rates sa juz w ustawieniach." } }, "status": 200, "keys": ["draft", "idea", "ok"], "expect": { "draft.kind": "done", "draft.state": "draft", "draft.to": "pilot.contract@example.com", "idea.status": "done", "idea.thread.*.state": ["cancelled", "draft"] }, "save": { "d1": "draft.id" } },
    { "say": "Send without naming the draft (the old {id} body) is refused", "post": "ideas/send-done", "body": { "id": "$pilot" }, "status": 400, "keys": ["ok", "reason"], "expect": { "reason": "bad-mail" } },
    { "say": "Send naming an e-mail the idea does not have", "post": "ideas/send-done", "body": { "id": "$pilot", "mail": "M-999" }, "status": 404, "expect": { "reason": "not-found" } },
    { "say": "a newer summary replaces the draft (Telegram, an agent)", "post": "ideas/done", "body": { "id": "$pilot", "summary": { "pl": "Typy rates i edytor sa juz w ustawieniach." } }, "status": 200, "expect": { "draft.state": "draft", "idea.thread.*.state": ["cancelled", "superseded", "draft"], "idea.thread.*.kind": ["reply", "done", "done"] }, "save": { "d2": "draft.id" } },
    { "say": "Send under the replaced draft: stale-draft", "post": "ideas/send-done", "body": { "id": "$pilot", "mail": "$d1" }, "status": 409, "keys": ["ok", "reason"], "expect": { "reason": "stale-draft" } },
    { "say": "a replaced draft is never sent by mail/send either", "post": "ideas/mail/send", "body": { "id": "$d1" }, "status": 409, "expect": { "reason": "stale-draft" } },
    { "say": "nor cancelled", "post": "ideas/mail/cancel", "body": { "id": "$d1" }, "status": 409, "expect": { "reason": "stale-draft" } },
    { "say": "re-reading the idea shows the current draft", "get": "ideas/$pilot", "status": 200, "expect": { "idea.thread.*.id": ["$r1", "$d1", "$d2"], "idea.thread.*.state": ["cancelled", "superseded", "draft"] } },
    { "say": "Send under the current draft queues it", "post": "ideas/send-done", "body": { "id": "$pilot", "mail": "$d2" }, "status": 200, "keys": ["idea", "mail", "ok"], "expect": { "mail.id": "$d2", "mail.state": "queued", "idea.thread.*.state": ["cancelled", "superseded", "queued"] } },
    { "say": "a second Send: no-draft", "post": "ideas/send-done", "body": { "id": "$pilot", "mail": "$d2" }, "status": 409, "expect": { "reason": "no-draft" } },
    { "say": "the owner writes down a pilot's idea", "post": "ideas/note", "body": { "text": "A pilot at the field asked for a lap timer.", "contact": "pilot.three@example.com", "lang": "es", "urgency": "high", "kind": "note" }, "status": 200, "keys": ["idea", "ok"], "expect": { "idea.kind": "note", "idea.status": "new", "idea.urgency": "high", "idea.email": "pilot.three@example.com", "idea.lang": "es" } },
    { "say": "an empty note", "post": "ideas/note", "body": { "text": "  ", "kind": "note" }, "status": 400, "expect": { "reason": "empty" } },
    { "say": "Gmail goes away", "world": { "mail": false } },
    { "say": "the list says so", "get": "ideas", "status": 200, "expect": { "mail.configured": false } },
    { "say": "a reply waits for Gmail", "post": "ideas/reply", "body": { "id": "$pilot", "text": "Second answer while Gmail is off." }, "status": 200, "expect": { "mail.state": "waiting_setup" }, "save": { "r2": "mail.id" } },
    { "say": "Send again while Gmail is still off: it keeps waiting", "post": "ideas/mail/send", "body": { "id": "$r2" }, "status": 200, "keys": ["idea", "mail", "ok"], "expect": { "mail.id": "$r2", "mail.state": "waiting_setup" } },
    { "say": "ideas.json becomes unreadable", "world": { "store": "broken" } },
    { "say": "the list answers 503 ideas-store", "get": "ideas", "status": 503, "keys": ["ok", "reason"], "expect": { "reason": "ideas-store" } },
    { "say": "one idea too", "get": "ideas/$pilot", "status": 503, "expect": { "reason": "ideas-store" } },
    { "say": "a move too", "post": "ideas/update", "body": { "id": "$pilot", "status": "accepted" }, "status": 503, "expect": { "reason": "ideas-store" } },
    { "say": "a Send too", "post": "ideas/send-done", "body": { "id": "$pilot", "mail": "$d2" }, "status": 503, "expect": { "reason": "ideas-store" } },
    { "say": "the rest of the admin answers", "get": "catalog", "status": 200 }
  ]
}
